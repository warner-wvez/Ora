# Ora environment. Copy to .env, fill in values, and export before running a
# builder. Every variable is optional: the map itself needs none of them, and
# only the builder named on each line reads it.

OHGO_API_KEY=       # Ohio builder. Free key at https://publicapi.ohgo.com
WSDOT_API_KEY=      # Washington builder and the refresh-rate measurement. Free key at https://wsdot.wa.gov/traffic/api/
ROBOFLOW_API_KEY=   # vehicle-detection research only, the hosted Roboflow inference call
