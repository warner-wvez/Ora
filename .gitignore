# Secrets. research/vehicle-detection/.env holds a Roboflow private API key, and this repo
# publishes straight to a public GitHub Pages site, so nothing secret can be one
# `git add .` away from a commit.
.env
.env.*
!.env.example

# macOS
.DS_Store

# Vehicle-detection research artifacts: model weights, training data and frame captures
# (~100 MB). Outputs, not source: the pipeline that makes them is what belongs in git.
research/vehicle-detection/train/
research/vehicle-detection/live/
research/vehicle-detection/yolov8m.mlpackage/

# Python bytecode from running the builders locally.
__pycache__/
*.pyc

# Planning notes between sessions (specs, plans, handoffs) stay on this machine.
# The repo carries decisions as ADRs in docs/6-decisions/, not the drafts.
docs/superpowers/

# The docs generator's output, if it is ever rendered locally.
docs-site/
